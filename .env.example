# Postgres connection string (Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/launchpad"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Optional — enables the AI tagline suggestion feature on /submit.
# Without it, the feature shows a graceful "not configured" message.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
